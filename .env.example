# URL p?blica del sitio, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos local. Sustituye los placeholders por tus valores reales.
# Si usas el docker-compose de desarrollo incluido, crea tu .env local con sus credenciales dev-only.
DATABASE_URL=postgresql://TU_USUARIO:TU_PASSWORD@127.0.0.1:5432/TU_BASE

# Opcional: tama?o del pool para tu instalaci?n local.
PGPOOL_MAX=5
