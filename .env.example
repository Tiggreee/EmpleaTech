# URL pública del sitio, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos local. Sustituye los placeholders por tus valores reales.
# Si usas el docker-compose de desarrollo incluido, crea tu .env local con sus credenciales dev-only.
DATABASE_URL=postgres://USUARIO:CONTRASENA@127.0.0.1:5432/TU_BASE

# Opcional: tamaño del pool para tu instalación local.
PGPOOL_MAX=5
# Opcional: fuentes de vacantes que piden una clave gratuita. Sin ellas, la app usa solo las fuentes abiertas.
# Adzuna: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# USAJOBS: https://developer.usajobs.gov (el correo con el que registraste la clave)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
