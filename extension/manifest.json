{
  "manifest_version": 3,
  "name": "EmpleaTech",
  "version": "0.1.0",
  "description": "Llena tus formularios de postulación y tus propuestas freelance con tu perfil de EmpleaTech. Tú revisas y tú envías.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "fondo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "contenido.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.workana.com/*",
        "https://www.upwork.com/*",
        "https://www.freelancer.com/*"
      ],
      "js": [
        "propuesta.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "opciones.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "EmpleaTech"
  }
}
