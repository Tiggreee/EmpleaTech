{
  "name": "empleatech",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente personal de búsqueda de empleo con Next.js y Postgres local.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs --si-hay-base && next build",
    "start": "next start -H 127.0.0.1",
    "arrancar": "node scripts/arrancar.mjs",
    "detener": "node scripts/arrancar.mjs --detener",
    "estado": "node scripts/arrancar.mjs --estado",
    "inicio:instalar": "node scripts/arrancar.mjs --instalar-inicio",
    "inicio:quitar": "node scripts/arrancar.mjs --quitar-inicio",
    "respaldo": "node scripts/respaldo.mjs",
    "restaurar": "node scripts/respaldo.mjs --restaurar",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "recon": "node recon/recon.mjs",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "extension": "node scripts/extension.mjs",
    "tienda": "node scripts/tienda.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
